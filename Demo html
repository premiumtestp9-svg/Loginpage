      </div>

      <div class="field" data-field="password">
        <label>Password</label>
        <div class="input-wrap">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15" r="1.4"/></svg></span>
          <input type="password" id="loginPass" placeholder="••••••••••" autocomplete="current-password">
          <button type="button" class="eye" data-eye="loginPass"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.8"/></svg></button>
        </div>
        <div class="err-msg">Password is required.</div>
      </div>

      <!-- CLOUDFLARE TURNSTILE-STYLE VERIFICATION -->
      <div class="turnstile" id="turnstile">
        <div class="ts-frame">
          <div class="ts-left">
            <div class="ts-box" id="tsBox" role="checkbox" aria-checked="false" tabindex="0" aria-label="Verify you are human">
              <svg class="ts-empty" viewBox="0 0 24 24" fill="none"></svg>
              <svg class="ts-check" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.2 5.2L20 6.5"/></svg>
            </div>
            <div class="ts-spinner" id="tsSpinner"></div>
            <div class="ts-text" id="tsText">Verify you are human</div>
          </div>
          <div class="ts-logo">
            <svg viewBox="0 0 24 24" fill="none"><path fill="#f6821f" d="M12 2l8.5 4.9v9.8L12 21.6 3.5 16.7V6.9L12 2z"/><path fill="#fff" d="M12 5.3l6 3.5v6.9l-6 3.5-6-3.5V8.8l6-3.5z"/><path fill="#f6821f" d="M12 8.1l3.1 1.8v3.7L12 15.4l-3.1-1.8V9.9L12 8.1z"/></svg>
            <span>Cloudflare</span>
          </div>
        </div>
        <div class="ts-footer">
          <a href="#" onclick="return false;">Privacy <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
          <a href="#" onclick="return false;">Terms <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
        </div>
      </div>
      <div class="ts-status" id="tsStatus">Please complete the human verification above.</div>

      <div class="row-between">
        <label class="check"><input type="checkbox" checked> Remember me</label>
        <a href="#" class="link" onclick="toast('Password reset link sent to your inbox');return false;">Forgot password?</a>
      </div>

      <button type="submit" class="btn">Enter The Arena</button>

      <div class="divider">or</div>
      <button type="button" class="google-btn" onclick="googleAuth('Sign in')">
        <svg viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34.5 6.1 29.5 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.2-.1-2.3-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34.5 6.1 29.5 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.3 5.2C36.9 40.3 44 35 44 24c0-1.2-.1-2.3-.4-3.5z"/></svg>
        Sign in with Google
      </button>
    </form>

    <!-- ============ REGISTER ============ -->
    <form class="panel" id="registerPanel" novalidate>
      <div class="form-title">Join The Elite</div>
      <div class="form-sub">Create your competitor profile for Season VII.</div>

      <div class="field" data-field="name">
        <label>Full Name</label>
        <div class="input-wrap">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.4 7.2 17.9l.9-5.4L4.2 8.7l5.4-.8L12 3z"/></svg></span>
          <input type="text" id="regName" placeholder="Alex Carter" autocomplete="name">
        </div>
        <div class="err-msg">Please enter your full name.</div>
      </div>

      <div class="field" data-field="tag">
        <label>Gamertag</label>
        <div class="input-wrap">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 8h10M7 12h6"/><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 4V5z"/></svg></span>
          <input type="text" id="regTag" placeholder="VortexKing" autocomplete="nickname">
        </div>
        <div class="err-msg">Gamertag must be 3–16 characters (letters, numbers, _).</div>
      </div>

      <div class="field" data-field="email">
        <label>Email Address</label>
        <div class="input-wrap">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/></svg></span>
          <input type="email" id="regEmail" placeholder="champion@arena.gg" autocomplete="email">
        </div>
        <div class="err-msg">Please enter a valid email address.</div>
      </div>

      <div class="field" data-field="game">
        <label>Primary Game Title</label>
        <div class="input-wrap">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9h4M8 7v4M15 8h.01M18 10h.01"/><path d="M7 5h10a5 5 0 0 1 5 5v3a4 4 0 0 1-7 2.6L14 14h-4l-1 1.6A4 4 0 0 1 2 13v-3a5 5 0 0 1 5-5z"/></svg></span>
          <select id="regGame">
            <option value="">Select your battleground</option>
            <option>Valorant</option>
            <option>Counter-Strike 2</option>
            <option>League of Legends</option>
            <option>Dota 2</option>
            <option>Apex Legends</option>
            <option>Call of Duty: Warzone</option>
            <option>Fortnite</option>
          </select>
          <span class="caret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg></span>
        </div>
        <div class="err-msg">Please select your primary game title.</div>
      </div>

      <div class="field" data-field="password">
        <label>Password</label>
        <div class="input-wrap">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15" r="1.4"/></svg></span>
          <input type="password" id="regPass" placeholder="Min. 8 characters" autocomplete="new-password">
          <button type="button" class="eye" data-eye="regPass"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.8"/></svg></button>
        </div>
        <div class="meter"><div class="meter-fill" id="meterFill"></div></div>
        <div class="meter-label" id="meterLabel"></div>
        <div class="err-msg">Password must be at least 8 characters.</div>
      </div>

      <div class="field" data-field="confirm">
        <label>Confirm Password</label>
        <div class="input-wrap">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M9.5 15l2 2 3.5-3.5"/></svg></span>
          <input type="password" id="regConfirm" placeholder="Repeat your password" autocomplete="new-password">
          <button type="button" class="eye" data-eye="regConfirm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.8"/></svg></button>
        </div>
        <div class="err-msg">Passwords do not match.</div>
      </div>

      <div class="row-between" style="margin-top:0;">
        <label class="check"><input type="checkbox" id="terms"> Accept <a href="#" class="link" onclick="return false;">Terms &amp; Rules</a></label>
      </div>

      <button type="submit" class="btn">Claim Your Slot</button>

      <div class="divider">or</div>
      <button type="button" class="google-btn" onclick="googleAuth('Sign up')">
        <svg viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34.5 6.1 29.5 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.2-.1-2.3-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34.5 6.1 29.5 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.3 5.2C36.9 40.3 44 35 44 24c0-1.2-.1-2.3-.4-3.5z"/></svg>
        Sign up with Google
      </button>
    </form>

    <!-- SUCCESS OVERLAY -->
    <div class="success-overlay" id="successOverlay">
      <div class="success-ring">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.2 5.2L20 6.5"/></svg>
      </div>
      <h3 id="successTitle">Welcome to the Arena</h3>
      <p id="successMsg">Your registration for Arena Royale Season VII has been received. Check your email for your official competitor pass.</p>
      <button class="btn" style="width:auto;padding:12px 34px;" onclick="closeSuccess()">Continue</button>
    </div>
  </section>
</div>

<div class="toast" id="toast"></div>

<script>
/* ---------- Sky dust particles ---------- */
const pc=document.getElementById('particles');
for(let i=0;i<28;i++){
  const p=document.createElement('div');
  p.className='particle';
  const s=Math.random()*5+2;
  p.style.width=p.style.height=s+'px';
  p.style.left=Math.random()*100+'%';
  p.style.animationDuration=(Math.random()*10+8)+'s';
  p.style.animationDelay=(Math.random()*10)+'s';
  pc.appendChild(p);
}

/* ---------- Tabs ---------- */
const tabs=document.getElementById('tabs');
tabs.querySelectorAll('.tab').forEach(t=>{
  t.addEventListener('click',()=>{
    tabs.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
    const isReg=t.dataset.tab==='register';
    tabs.classList.toggle('register',isReg);
    document.getElementById('loginPanel').classList.toggle('active',!isReg);
    document.getElementById('registerPanel').classList.toggle('active',isReg);
    document.getElementById('tsStatus').classList.remove('show');
  });
});

/* ---------- Show/hide password ---------- */
document.querySelectorAll('.eye').forEach(b=>{
  b.addEventListener('click',()=>{
    const inp=document.getElementById(b.dataset.eye);
    inp.type=inp.type==='password'?'text':'password';
    b.style.opacity=inp.type==='password'?'1':'0.55';
  });
});

/* ---------- Password strength meter ---------- */
const regPass=document.getElementById('regPass');
const meterFill=document.getElementById('meterFill');
const meterLabel=document.getElementById('meterLabel');
regPass.addEventListener('input',()=>{
  const v=regPass.value;let score=0;
  if(v.length>=8)score++;
  if(v.length>=12)score++;
  if(/[A-Z]/.test(v)&&/[a-z]/.test(v))score++;
  if(/\d/.test(v))score++;
  if(/[^A-Za-z0-9]/.test(v))score++;
  const levels=[
    {w:'0%',c:'transparent',t:''},
    {w:'25%',c:'#ff6b7a',t:'Weak — forge stronger'},
    {w:'45%',c:'#ffb35c',t:'Fair'},
    {w:'65%',c:'#7dd3fc',t:'Good'},
    {w:'85%',c:'#5eead4',t:'Strong'},
    {w:'100%',c:'#34d399',t:'Legendary Rank'}
  ];
  const L=levels[v.length===0?0:score];
  meterFill.style.width=L.w;meterFill.style.background=L.c;
  meterFill.style.boxShadow=L.c!=='transparent'?`0 0 12px ${L.c}`:'none';
  meterLabel.textContent=L.t;meterLabel.style.color=L.c;
});

/* ---------- Validation helpers ---------- */
const emailRe=/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
function setErr(input,bad){input.closest('.field').classList.toggle('error',bad);return !bad;}

/* ================================================================
   CLOUDFLARE TURNSTILE-STYLE VERIFICATION — LOGIN PAGE ONLY
   Flow: idle → verifying (spinner, ~1.6s) → success (green check)
   In production, replace this block with the real widget:
   <div class="cf-turnstile" data-sitekey="YOUR_SITE_KEY"></div>
   + https://challenges.cloudflare.com/turnstile/v0/api.js
================================================================ */
const tsBox=document.getElementById('tsBox');
const tsSpinner=document.getElementById('tsSpinner');
const tsText=document.getElementById('tsText');
const tsStatus=document.getElementById('tsStatus');
let tsVerified=false,tsBusy=false;

function tsStartVerify(){
  if(tsVerified||tsBusy)return;
  tsBusy=true;
  tsBox.style.display='none';
  tsSpinner.style.display='block';
  tsText.textContent='Verifying...';
  tsStatus.classList.remove('show');
  setTimeout(()=>{
    tsSpinner.style.display='none';
    tsBox.style.display='flex';
    tsBox.classList.add('verified');
    tsBox.setAttribute('aria-checked','true');
    tsText.textContent='Success!';
    tsText.classList.add('success');
    tsVerified=true;tsBusy=false;
  },1600);
}
tsBox.addEventListener('click',tsStartVerify);
tsBox.addEventListener('keydown',e=>{if(e.key===' '||e.key==='Enter'){e.preventDefault();tsStartVerify();}});

function tsReset(){
  tsVerified=false;tsBusy=false;
  tsBox.classList.remove('verified');
  tsBox.setAttribute('aria-checked','false');
  tsText.textContent='Verify you are human';
  tsText.classList.remove('success');
}

/* ---------- Login submit ---------- */
document.getElementById('loginPanel').addEventListener('submit',e=>{
  e.preventDefault();
  const id=document.getElementById('loginId');
  const pw=document.getElementById('loginPass');
  let ok=true;
  ok=setErr(id,id.value.trim().length<3)&&ok;
  ok=setErr(pw,pw.value.length<1)&&ok;
  if(!ok)return;
  if(!tsVerified){
    tsStatus.classList.add('show');
    tsStatus.textContent='Please complete the human verification above.';
    tsStatus.style.color='var(--error)';
    return;
  }
  showSuccess('Welcome Back, Champion','Verification passed · Authentication successful. Preparing your dashboard — brackets, stats and match schedule await.');
  tsReset();
});

/* ---------- Register submit ---------- */
document.getElementById('registerPanel').addEventListener('submit',e=>{
  e.preventDefault();
  const name=document.getElementById('regName');
  const tag=document.getElementById('regTag');
  const email=document.getElementById('regEmail');
  const game=document.getElementById('regGame');
  const pw=document.getElementById('regPass');
  const cf=document.getElementById('regConfirm');
  const terms=document.getElementById('terms');
  let ok=true;
  ok=setErr(name,name.value.trim().length<2)&&ok;
  ok=setErr(tag,!/^[A-Za-z0-9_]{3,16}$/.test(tag.value.trim()))&&ok;
  ok=setErr(email,!emailRe.test(email.value.trim()))&&ok;
  ok=setErr(game,game.value==='')&&ok;
  ok=setErr(pw,pw.value.length<8)&&ok;
  ok=setErr(cf,cf.value!==pw.value||cf.value==='')&&ok;
  if(!terms.checked){toast('Please accept the tournament terms to proceed.');return;}
  if(!ok)return;
  showSuccess('Welcome to the Arena','Your registration for Arena Royale Season VII has been received. Check your email for your official competitor pass.');
});

/* Live-clear errors */
document.querySelectorAll('input,select').forEach(i=>{
  i.addEventListener('input',()=>i.closest('.field').classList.remove('error'));
  i.addEventListener('change',()=>i.closest('.field').classList.remove('error'));
});

/* ---------- Google auth (stub) ---------- */
function googleAuth(mode){
  toast(mode+' with Google... redirecting to accounts.google.com','info');
}

/* ---------- Success overlay ---------- */
function showSuccess(title,msg){
  document.getElementById('successTitle').textContent=title;
  document.getElementById('successMsg').textContent=msg;
  document.getElementById('successOverlay').classList.add('show');
}
function closeSuccess(){
  document.getElementById('successOverlay').classList.remove('show');
  document.getElementById('loginPanel').reset();
  document.getElementById('registerPanel').reset();
  meterFill.style.width='0';meterLabel.textContent='';
  tsReset();
  tabs.querySelector('[data-tab="login"]').click();
}

/* ---------- Toast ---------- */
let toastTimer;
function toast(msg,type){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.classList.toggle('info',type==='info');
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),3400);
}
</script>
</body>
</html>
